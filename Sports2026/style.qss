* {
    font-family: "Microsoft YaHei";
    font-size: 9pt;
}

/* === 主窗口 === */
QMainWindow {
    background-color: #F0F2F5;
}

/* === 菜单栏 === */
QMenuBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 2px 0px;
    font-size: 10pt;
}
QMenuBar::item {
    padding: 6px 12px;
    background: transparent;
    border-radius: 4px;
    margin: 2px 2px;
}
QMenuBar::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}
QMenu {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    padding: 4px 0px;
}
QMenu::item {
    padding: 8px 32px 8px 20px;
    font-size: 9pt;
}
QMenu::item:selected {
    background-color: #E3F2FD;
    color: #1976D2;
}
QMenu::separator {
    height: 1px;
    background: #E0E0E0;
    margin: 4px 10px;
}

/* === 工具栏 === */
QToolBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E0E0E0;
    padding: 4px 8px;
    spacing: 6px;
}
QToolBar::separator {
    width: 1px;
    background: #E0E0E0;
    margin: 4px 4px;
}
QToolButton {
    border: 1px solid transparent;
    border-radius: 4px;
    padding: 6px 14px;
    font-size: 9pt;
    color: #424242;
}
QToolButton:hover {
    background-color: #E3F2FD;
    border-color: #BBDEFB;
    color: #1976D2;
}
QToolButton:pressed {
    background-color: #BBDEFB;
}

/* === 状态栏 === */
QStatusBar {
    background-color: #E3F2FD;
    border-top: 1px solid #BBDEFB;
    color: #1565C0;
    font-size: 9pt;
    padding: 2px 8px;
}

/* === 表格视图 === */
QTableView {
    background-color: #FFFFFF;
    alternate-background-color: #d5f1f2;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
    gridline-color: #E8ECF0;
    selection-background-color: #BBDEFB;
    selection-color: #212121;
    font-size: 9pt;
}
QTableView::item {
    padding: 6px 10px;
    border-bottom: 1px solid #F0F0F0;
}
QTableView::item:selected {
    background-color: #BBDEFB;
    color: #212121;
}
QHeaderView::section {
    background-color: #1976D2;
    color: #FFFFFF;
    padding: 6px 10px;
    border: none;
    border-right: 1px solid #1565C0;
    font-weight: bold;
    font-size: 9pt;
}
QHeaderView::section:hover {
    background-color: #1E88E5;
}
/* 排序箭头 - 白色醒目 */
QHeaderView::down-arrow { image: none; width: 0px; height: 0px; }
QHeaderView::up-arrow { image: none; width: 0px; height: 0px; }

/* === 按钮 === */
QPushButton {
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 8px 20px;
    background-color: #FFFFFF;
    color: #424242;
    font-size: 9pt;
    min-width: 70px;
}
QPushButton:hover {
    background-color: #F5F5F5;
    border-color: #1976D2;
    color: #1976D2;
}
QPushButton:pressed {
    background-color: #E0E0E0;
}
QPushButton:default {
    background-color: #1976D2;
    color: #FFFFFF;
    border-color: #1565C0;
}
QPushButton:default:hover {
    background-color: #1E88E5;
}
QPushButton:default:pressed {
    background-color: #1565C0;
}

/* === 输入框 === */
QLineEdit, QSpinBox, QDoubleSpinBox, QDateEdit, QComboBox {
    border: 1px solid #D0D0D0;
    border-radius: 4px;
    padding: 6px 10px;
    background-color: #FFFFFF;
    font-size: 9pt;
    min-height: 20px;
}
QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QComboBox:focus {
    border-color: #1976D2;
    border-width: 2px;
    padding: 5px 9px;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 24px;
    border-left: 1px solid #D0D0D0;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    background: #FAFAFA;
}
QComboBox::drop-down:hover {
    background: #E3F2FD;
}
QComboBox QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    selection-background-color: #E3F2FD;
    selection-color: #1976D2;
}
QDateEdit::drop-down {
    border: none;
    width: 24px;
}

/* === 日历控件 === */
QCalendarWidget {
    background-color: #FFFFFF;
    border: 1px solid #E0E0E0;
    border-radius: 4px;
}
QCalendarWidget QToolButton {
    color: #424242;
    border: none;
    padding: 4px 8px;
    border-radius: 3px;
}
QCalendarWidget QToolButton:hover {
    background-color: #E3F2FD;
    color: #1976D2;
}
QCalendarWidget QMenu {
    background-color: #FFFFFF;
}
QCalendarWidget QSpinBox {
    border: 1px solid #D0D0D0;
    border-radius: 3px;
    padding: 2px 6px;
}
QCalendarWidget QTableView {
    alternate-background-color: #F5F8FC;
    selection-background-color: #BBDEFB;
    selection-color: #212121;
}

/* === 分组框 === */
QGroupBox {
    border: 1px solid #E0E0E0;
    border-radius: 6px;
    margin-top: 12px;
    padding-top: 16px;
    font-size: 10pt;
    font-weight: bold;
    color: #424242;
}
QGroupBox::title {
    subcontrol-origin: margin;
    left: 16px;
    padding: 0 8px;
    color: #1976D2;
}

/* === 标签 === */
QLabel {
    color: #424242;
    font-size: 9pt;
}

/* === 单选按钮 === */
QRadioButton {
    spacing: 6px;
    font-size: 9pt;
    color: #424242;
}
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    border: 2px solid #BDBDBD;
    background: #FFFFFF;
}
QRadioButton::indicator:hover {
    border-color: #1976D2;
}
QRadioButton::indicator:checked {
    background-color: #1976D2;
    border: 2px solid #1976D2;
    border-radius: 8px;
}

/* === 对话框 === */
QDialog {
    background-color: #F5F7FA;
}
