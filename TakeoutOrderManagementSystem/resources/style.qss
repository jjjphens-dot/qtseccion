QWidget { color: #182230; background-color: #f4f6fa; font-family: "Microsoft YaHei UI", "Segoe UI"; font-size: 14px; }
QLabel { color: #182230; background: transparent; }
QLabel#heading { font-size: 26px; font-weight: 600; padding: 12px 4px; color: #172b4d; }
QLabel#pageTitle { font-size: 20px; font-weight: 600; padding: 12px 0; color: #172b4d; }
QLabel#notice { background: #e8eef7; color: #233c61; padding: 12px; border-radius: 6px; }
QListWidget, QTableView, QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit, QTextEdit, QPlainTextEdit {
    color: #182230; background-color: #ffffff; border: 1px solid #b8c2ce; border-radius: 4px;
    selection-background-color: #1769aa; selection-color: #ffffff;
}
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QDateTimeEdit { padding: 8px; }
QLineEdit:disabled, QComboBox:disabled, QSpinBox:disabled, QTextEdit:disabled { color: #5e6672; background-color: #e6eaf0; }
QListWidget { border-radius: 0; }
QListWidget::item { color: #182230; background: #ffffff; padding: 16px; }
QListWidget::item:hover { background: #edf4ff; color: #14396d; }
QListWidget::item:selected { background: #1769aa; color: #ffffff; }
QListWidget::item:selected:inactive { background: #315f8a; color: #ffffff; }
QTableView { color: #182230; background: #ffffff; alternate-background-color: #f7f9fc; gridline-color: #d6dde6; }
QTableView::item { color: #182230; background: #ffffff; padding: 6px; }
QTableView::item:alternate { background: #f7f9fc; }
QTableView::item:selected { color: #ffffff; background: #1769aa; }
QHeaderView { color: #182230; background: #eaf0f7; }
QHeaderView::section { color: #182230; background: #eaf0f7; padding: 10px; border: 0; border-right: 1px solid #ccd5e0; border-bottom: 1px solid #ccd5e0; }
QTableCornerButton::section { background: #eaf0f7; border: 0; border-right: 1px solid #ccd5e0; border-bottom: 1px solid #ccd5e0; }
QPushButton { color: #ffffff; background: #1769aa; border: 1px solid #125887; border-radius: 4px; padding: 8px 16px; }
QPushButton:hover { background: #125887; }
QPushButton:pressed { background: #0e456d; }
QPushButton:disabled { color: #6f7782; background: #d9dee5; border-color: #c6cdd6; }
QCheckBox, QRadioButton, QGroupBox { color: #182230; background: transparent; }
QGroupBox { border: 1px solid #b8c2ce; border-radius: 5px; margin-top: 10px; padding-top: 10px; }
QMenuBar, QMenu, QStatusBar { color: #182230; background: #ffffff; }
QMenuBar::item:selected, QMenu::item:selected { color: #ffffff; background: #1769aa; }
QToolTip { color: #ffffff; background: #182230; border: 1px solid #667085; }
